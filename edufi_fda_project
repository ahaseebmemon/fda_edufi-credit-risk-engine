        "# ======================================================\n",
        "# Threshold Tuning for Logistic Regression (Augmented)\n",
        "# After SMOTETomek + Scaling + Class Weights\n",
        "# ======================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n",
        "from imblearn.combine import SMOTETomek\n",
        "\n",
        "# 1) Load augmented dataset\n",
        "augmented_df = pd.read_csv(\"/content/final_augmented_dataset.csv\")\n",
        "augmented_df['default'] = augmented_df['default'].astype(int)\n",
        "\n",
        "# 2) Select numeric features\n",
        "numeric_cols = augmented_df.select_dtypes(include=['float64', 'int64']).columns.tolist()\n",
        "numeric_cols.remove('default')\n",
        "if 'customer_id' in numeric_cols:\n",
        "    numeric_cols.remove('customer_id')\n",
        "\n",
        "X = augmented_df[numeric_cols]\n",
        "y = augmented_df['default']\n",
        "\n",
        "# 3) Train / Test split\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=0.25, random_state=42, stratify=y\n",
        ")\n",
        "\n",
        "# 4) Balance with SMOTETomek\n",
        "sm = SMOTETomek(random_state=42)\n",
        "X_res, y_res = sm.fit_resample(X_train, y_train)\n",
        "\n",
        "print(\"After SMOTETomek:\", pd.Series(y_res).value_counts())\n",
        "\n",
        "# 5) Scale features\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "scaler = StandardScaler()\n",
        "X_res_scaled = scaler.fit_transform(X_res)\n",
        "X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "# 6) Fit Logistic Regression with class_weight\n",
        "lr = LogisticRegression(class_weight='balanced', max_iter=1000)\n",
        "lr.fit(X_res_scaled, y_res)\n",
        "\n",
        "# 7) Try different thresholds\n",
        "thresholds = np.arange(0.20, 0.61, 0.05)   # 0.20, 0.25, ..., 0.60\n",
        "probs = lr.predict_proba(X_test_scaled)[:, 1]\n",
        "\n",
        "rows = []\n",
        "for th in thresholds:\n",
        "    preds = (probs > th).astype(int)\n",
        "    acc = accuracy_score(y_test, preds)\n",
        "    prec = precision_score(y_test, preds)\n",
        "    rec = recall_score(y_test, preds)\n",
        "    f1 = f1_score(y_test, preds)\n",
        "    rows.append([th, acc, prec, rec, f1])\n",
        "\n",
        "results_thr = pd.DataFrame(rows, columns=['Threshold', 'Accuracy', 'Precision', 'Recall', 'F1'])\n",
        "print(\"\\nThreshold tuning results (Augmented + LR):\")\n",
        "print(results_thr)\n",
        "\n",
        "# 8) Show best by F1\n",
        "best_row = results_thr.sort_values('F1', ascending=False).head(1)\n",
        "print(\"\\nBest threshold by F1:\")\n",
        "print(best_row)\n"
