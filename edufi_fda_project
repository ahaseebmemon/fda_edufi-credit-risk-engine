        "# ============================================================\n",
        "# EDUFI – ADD REAL-BASED ALTERNATE FEATURES (NO MANUAL BROWSING)\n",
        "# ------------------------------------------------------------\n",
        "# Starting from: primary_cleaned_full.csv\n",
        "# Adds:\n",
        "#   - university, program, city\n",
        "#   - University_Prestige_Score  (from EduRank national rank)\n",
        "#   - Program_Employability_Score (from salary ranges by field)\n",
        "#   - City_Income_Index (from city income/poverty patterns)\n",
        "# Saves: augmented_for_modeling_v3.csv\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# 1) Load primary cleaned dataset\n",
        "base_path = \"/content/primary_selected_with_customer_id.csv\"\n",
        "  # change if needed\n",
        "df = pd.read_csv(base_path)\n",
        "\n",
        "print(\"✅ Loaded primary dataset:\", df.shape)\n",
        "\n",
        "# 2) Drop any old alternate features if they exist\n",
        "old_alt_cols = [\n",
        "    \"Digital_Budgeting_SD\",\n",
        "    \"Edu_Completion_Signal\",\n",
        "    \"Major_Risk_Rating\",\n",
        "    \"University_Prestige_Score\",\n",
        "    \"Program_Employability_Score\",\n",
        "    \"City_Income_Index\",\n",
        "    \"City_NTL_Score\",\n",
        "    \"EduFi_Alt_Risk_Index\"\n",
        "]\n",
        "\n",
        "cols_to_drop = [c for c in old_alt_cols if c in df.columns]\n",
        "if cols_to_drop:\n",
        "    df = df.drop(columns=cols_to_drop)\n",
        "    print(\"🧹 Dropped old alternate columns:\", cols_to_drop)\n",
        "else:\n",
        "    print(\"ℹ️ No old alternate columns found to drop.\")\n",
        "\n",
        "# 3) Add basic categorical fields: university, program, city\n",
        "#    (EduFi would normally collect these at application time.\n",
        "#     Here we simulate them so we can attach real-based indices.)\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "universities = [\"LUMS\", \"IBA\", \"NUST\", \"FAST\", \"COMSATS\", \"UOL\"]\n",
        "programs = [\"Computer Science\", \"Business\", \"Engineering\", \"Psychology\", \"Media\", \"Fashion\"]\n",
        "cities = [\"Karachi\", \"Lahore\", \"Islamabad\", \"Multan\", \"Quetta\"]\n",
        "\n",
        "if \"university\" not in df.columns:\n",
        "    df[\"university\"] = np.random.choice(universities, size=len(df))\n",
        "if \"program\" not in df.columns:\n",
        "    df[\"program\"] = np.random.choice(programs, size=len(df))\n",
        "if \"city\" not in df.columns:\n",
        "    df[\"city\"] = np.random.choice(cities, size=len(df))\n",
        "\n",
        "print(\"\\n📌 Sample of university/program/city assignments:\")\n",
        "display(df[[\"customer_id\", \"university\", \"program\", \"city\"]].head())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4) REAL-BASED ALTERNATE FEATURES\n",
        "# ------------------------------------------------------------\n",
        "# NOTE: Scores below are derived from:\n",
        "# - EduRank national rankings for Pakistani universities\n",
        "#   (lower rank number = more prestigious).\n",
        "# - Reported starting salaries by field for fresh grads in Pakistan.\n",
        "# - City-level income/poverty patterns (Islamabad highest, Quetta lowest).\n",
        "#\n",
        "# They are simplified to a 0–100 scale for modeling convenience.\n",
        "\n",
        "# 4.1 University_Prestige_Score (based on EduRank Pakistan rank)\n",
        "# EduRank 2025 national ranks (approx):\n",
        "#   COMSATS: 2nd, LUMS: 5th, UOL: 13th, NUST: 10th, FAST: 14th, IBA: 23rd.\n",
        "# We convert rank -> score using: score = 100 - (rank-1)*2  (then clipped to [50, 100]).\n",
        "\n",
        "uni_rank_in_pk = {\n",
        "    \"COMSATS\": 2,\n",
        "    \"LUMS\": 5,\n",
        "    \"NUST\": 10,\n",
        "    \"FAST\": 14,\n",
        "    \"UOL\": 13,\n",
        "    \"IBA\": 23\n",
        "}\n",
        "\n",
        "def rank_to_score(rank):\n",
        "    base = 100 - (rank - 1) * 2\n",
        "    return max(50, min(100, base))\n",
        "\n",
        "df[\"University_Prestige_Score\"] = df[\"university\"].map(\n",
        "    lambda u: rank_to_score(uni_rank_in_pk.get(u, 25))  # default rank 25 if missing\n",
        ")\n",
        "\n",
        "# 4.2 Program_Employability_Score (based on salary by field)\n",
        "# From salary reports: Engineering & CS start highest, then IT/Business, then humanities/media.\n",
        "# We map them to a 0–100 scale.\n",
        "\n",
        "program_emp = {\n",
        "    \"Engineering\": 92,        # highest\n",
        "    \"Computer Science\": 90,\n",
        "    \"Business\": 80,\n",
        "    \"Psychology\": 60,\n",
        "    \"Media\": 55,\n",
        "    \"Fashion\": 50             # relatively lower earning / demand\n",
        "}\n",
        "\n",
        "df[\"Program_Employability_Score\"] = df[\"program\"].map(program_emp)\n",
        "\n",
        "# 4.3 City_Income_Index (based on city income / poverty patterns)\n",
        "# From UN-Habitat & income studies: Islamabad > Karachi ≈ Lahore > Multan > Quetta.\n",
        "# We again map to a 0–100 scale as a relative affluence index.\n",
        "\n",
        "city_income = {\n",
        "    \"Islamabad\": 90,   # highest per-capita income, lowest poverty\n",
        "    \"Karachi\": 80,\n",
        "    \"Lahore\": 78,\n",
        "    \"Multan\": 60,\n",
        "    \"Quetta\": 50       # highest poverty among these\n",
        "}\n",
        "\n",
        "df[\"City_Income_Index\"] = df[\"city\"].map(city_income)\n",
        "\n",
        "print(\"\\n📌 Preview of new alternate features:\")\n",
        "display(df[[\n",
        "    \"customer_id\", \"university\", \"University_Prestige_Score\",\n",
        "    \"program\", \"Program_Employability_Score\",\n",
        "    \"city\", \"City_Income_Index\"\n",
        "]].head())\n",
        "\n",
        "# 4.4 OPTIONAL: Combined alternate-risk index (you can use just for EDA)\n",
        "df[\"EduFi_Alt_Risk_Index\"] = (\n",
        "    0.4 * (100 - df[\"University_Prestige_Score\"]) +\n",
        "    0.35 * (100 - df[\"Program_Employability_Score\"]) +\n",
        "    0.25 * (100 - df[\"City_Income_Index\"])\n",
        ")\n",
        "\n",
        "print(\"\\n📌 Sample of engineered EduFi_Alt_Risk_Index:\")\n",
        "display(df[[\n",
        "    \"customer_id\",\n",
        "    \"University_Prestige_Score\",\n",
        "    \"Program_Employability_Score\",\n",
        "    \"City_Income_Index\",\n",
        "    \"EduFi_Alt_Risk_Index\",\n",
        "    \"default\"\n",
        "]].head())\n",
        "\n",
        "# 5) SAVE AUGMENTED DATASET\n",
        "output_path = \"/content/augmented_for_modeling_v3.csv\"\n",
        "df.to_csv(output_path, index=False)\n",
        "print(f\"\\n💾 Saved augmented dataset with REAL-based alternate features as: {output_path}\")\n",
        "print(\"Final shape:\", df.shape)\n"
      ]
    },
