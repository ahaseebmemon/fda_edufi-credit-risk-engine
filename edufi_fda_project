        "\n",
        "# Load your augmented dataset\n",
        "df = pd.read_csv(\"/content/augmented_for_modeling_v3.csv\")\n",
        "\n",
        "# Load your NTL table\n",
        "ntl = pd.read_csv(\"/content/City_NTL_Score_Pakistan_2023.csv\")\n",
