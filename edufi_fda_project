      "source": [
        "# ============================================\n",
        "# FULL ML COMPARISON:\n",
        "# Primary Dataset vs Augmented Dataset\n",
        "# ============================================\n",
        "\n",
        "# 1) IMPORT LIBRARIES\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "from xgboost import XGBClassifier\n",
        "from lightgbm import LGBMClassifier\n",
        "\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, classification_report\n",
        "\n",
        "import warnings\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "# ============================================\n",
        "# 2) HELPER FUNCTION TO RUN MODELS ON A DATASET\n",
        "# ============================================\n",
        "\n",
        "def run_models_on_dataset(df, dataset_name):\n",
        "    \"\"\"\n",
        "    df: pandas DataFrame that MUST contain 'default' column.\n",
        "    dataset_name: just for printing (e.g. 'Primary', 'Augmented')\n",
        "    \"\"\"\n",
        "\n",
        "    print(\"\\n\" + \"=\"*80)\n",
        "    print(f\"RUNNING MODELS ON: {dataset_name} DATASET\")\n",
        "    print(\"=\"*80)\n",
        "\n",
        "    # ---- Select numeric features only ----\n",
        "    numeric_cols = df.select_dtypes(include=['float64', 'int64']).columns.tolist()\n",
        "\n",
        "    # Remove target from feature list\n",
        "    if 'default' in numeric_cols:\n",
        "        numeric_cols.remove('default')\n",
        "\n",
        "    # Remove ID column if present\n",
        "    if 'customer_id' in numeric_cols:\n",
        "        numeric_cols.remove('customer_id')\n",
        "\n",
        "    X = df[numeric_cols]\n",
        "    y = df['default']\n",
        "\n",
        "    print(f\"\\nUsing {len(numeric_cols)} numeric features:\")\n",
        "    print(numeric_cols)\n",
        "\n",
        "    # ---- Train/Test split ----\n",
        "    X_train, X_test, y_train, y_test = train_test_split(\n",
        "        X, y, test_size=0.25, random_state=42, stratify=y\n",
        "    )\n",
        "\n",
        "    # ---- Scaling ----\n",
        "    scaler = StandardScaler()\n",
        "    X_train_scaled = scaler.fit_transform(X_train)\n",
        "    X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "    # ---- Define models ----\n",
        "    models = {\n",
        "        \"Logistic Regression\": LogisticRegression(class_weight='balanced', max_iter=1000),\n",
        "        \"Random Forest\": RandomForestClassifier(n_estimators=200, random_state=42),\n",
        "        \"XGBoost\": XGBClassifier(\n",
        "            max_depth=4, learning_rate=0.1, subsample=0.9,\n",
        "            n_estimators=300, eval_metric='logloss', use_label_encoder=False\n",
        "        ),\n",
        "        \"LightGBM\": LGBMClassifier(),\n",
        "        \"KNN\": KNeighborsClassifier(n_neighbors=7)\n",
        "    }\n",
        "\n",
        "    results = []\n",
        "\n",
        "    # ---- Train + Evaluate each model ----\n",
        "    for name, model in models.items():\n",
        "\n",
        "        print(\"\\n\" + \"-\"*60)\n",
        "        print(f\"{dataset_name} – {name}\")\n",
        "        print(\"-\"*60)\n",
        "\n",
        "        # use scaled data for some models\n",
        "        if name in [\"Logistic Regression\", \"KNN\"]:\n",
        "            model.fit(X_train_scaled, y_train)\n",
        "            preds = model.predict(X_test_scaled)\n",
        "        else:\n",
        "            model.fit(X_train, y_train)\n",
        "            preds = model.predict(X_test)\n",
        "\n",
        "        acc = accuracy_score(y_test, preds)\n",
        "        prec = precision_score(y_test, preds)\n",
        "        rec = recall_score(y_test, preds)\n",
        "        f1 = f1_score(y_test, preds)\n",
        "\n",
        "        # Save results row\n",
        "        results.append([dataset_name, name, acc, prec, rec, f1])\n",
        "\n",
        "        # Print detailed report\n",
        "        print(classification_report(y_test, preds))\n",
        "\n",
        "    # Return results DataFrame\n",
        "    results_df = pd.DataFrame(\n",
        "        results,\n",
        "        columns=[\"Dataset\", \"Model\", \"Accuracy\", \"Precision\", \"Recall\", \"F1\"]\n",
        "    )\n",
        "    return results_df\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 3) LOAD BOTH DATASETS\n",
        "# ============================================\n",
        "\n",
        "# Primary dataset (before alternate features)\n",
        "primary_df = pd.read_csv(\"/content/primary_selected_with_customer_id.csv\")\n",
        "print(\"Primary Dataset Loaded:\", primary_df.shape)\n",
        "\n",
        "# Augmented dataset (after alternate features added)\n",
        "augmented_df = pd.read_csv(\"/content/final_augmented_dataset.csv\")\n",
        "print(\"Augmented Dataset Loaded:\", augmented_df.shape)\n",
        "\n",
        "# Make sure both have 'default' column as int\n",
        "primary_df['default'] = primary_df['default'].astype(int)\n",
        "augmented_df['default'] = augmented_df['default'].astype(int)\n",
        "\n",
        "# ============================================\n",
        "# 4) RUN MODELS ON PRIMARY DATASET (BASELINE)\n",
        "# ============================================\n",
        "\n",
        "primary_results = run_models_on_dataset(primary_df, \"Primary\")\n",
        "\n",
        "# ============================================\n",
        "# 5) RUN MODELS ON AUGMENTED DATASET (WITH ALT FEATURES)\n",
        "# ============================================\n",
        "\n",
        "augmented_results = run_models_on_dataset(augmented_df, \"Augmented\")\n",
        "\n",
        "# ============================================\n",
        "# 6) COMBINE & COMPARE RESULTS\n",
        "# ============================================\n",
        "\n",
        "all_results = pd.concat([primary_results, augmented_results], ignore_index=True)\n",
        "\n",
        "print(\"\\n\\n================= FULL COMPARISON TABLE =================\")\n",
        "print(all_results)\n",
        "\n",
        "# Nice pivot view: rows = Model, columns = Dataset (Primary vs Augmented)\n",
        "comparison_table = all_results.pivot_table(\n",
        "    index='Model', columns='Dataset', values=['Accuracy', 'Precision', 'Recall', 'F1']\n",
        ")\n",
        "\n",
        "print(\"\\n\\n============= METRIC COMPARISON: PRIMARY vs AUGMENTED =============\")\n",
        "print(comparison_table)\n",
        "\n",
        "comparison_table\n"
      ],
