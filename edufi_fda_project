      "source": [
        "# ======================================================\n",
        "# IMPROVED ML PIPELINE FOR BOTH DATASETS\n",
        "# - SMOTETomek\n",
        "# - Class weights\n",
        "# - Threshold tuning\n",
        "# - 5 ML models\n",
        "# ======================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "from xgboost import XGBClassifier\n",
        "from lightgbm import LGBMClassifier\n",
        "\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n",
        "from imblearn.combine import SMOTETomek\n",
        "import warnings\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "\n",
        "# ======================================================\n",
        "# Helper: Evaluate model with custom threshold\n",
        "# ======================================================\n",
        "def evaluate_with_threshold(model, X_test, y_test, threshold=0.35):\n",
        "    probs = model.predict_proba(X_test)[:, 1]\n",
        "    preds = (probs > threshold).astype(int)\n",
        "\n",
        "    acc = accuracy_score(y_test, preds)\n",
        "    prec = precision_score(y_test, preds)\n",
        "    rec = recall_score(y_test, preds)\n",
        "    f1 = f1_score(y_test, preds)\n",
        "\n",
        "    return acc, prec, rec, f1\n",
        "\n",
        "\n",
        "# ======================================================\n",
        "# Helper: Balanced modeling on a dataset (Primary/Augmented)\n",
        "# ======================================================\n",
        "def run_balanced_modeling(df, dataset_name):\n",
        "\n",
        "    print(\"\\n\" + \"=\"*80)\n",
        "    print(f\"RUNNING IMPROVED MODELS ON: {dataset_name} DATASET\")\n",
        "    print(\"=\"*80)\n",
        "\n",
        "    # numeric features only\n",
        "    numeric_cols = df.select_dtypes(include=['float64', 'int64']).columns.tolist()\n",
        "\n",
        "    # remove target + id\n",
        "    if 'default' in numeric_cols:\n",
        "        numeric_cols.remove('default')\n",
        "    if 'customer_id' in numeric_cols:\n",
        "        numeric_cols.remove('customer_id')\n",
        "\n",
        "    X = df[numeric_cols]\n",
        "    y = df['default'].astype(int)\n",
        "\n",
        "    # split\n",
        "    X_train, X_test, y_train, y_test = train_test_split(\n",
        "        X, y, test_size=0.25, random_state=42, stratify=y\n",
        "    )\n",
        "\n",
        "    # balance using SMOTETomek\n",
        "    sm = SMOTETomek(random_state=42)\n",
        "    X_res, y_res = sm.fit_resample(X_train, y_train)\n",
        "\n",
        "    print(\"\\nAfter SMOTETomek balancing:\")\n",
        "    print(pd.Series(y_res).value_counts())\n",
        "\n",
        "    # scaling\n",
        "    scaler = StandardScaler()\n",
        "    X_res_scaled = scaler.fit_transform(X_res)\n",
        "    X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "    # models with class weights\n",
        "    models = {\n",
        "        \"Logistic Regression\": LogisticRegression(class_weight='balanced', max_iter=1000),\n",
        "        \"Random Forest\": RandomForestClassifier(class_weight='balanced'),\n",
        "        \"XGBoost\": XGBClassifier(\n",
        "            scale_pos_weight = len(y_res[y_res==0]) / len(y_res[y_res==1]),\n",
        "            eval_metric='logloss'\n",
        "        ),\n",
        "        \"LightGBM\": LGBMClassifier(class_weight='balanced'),\n",
        "        \"KNN\": KNeighborsClassifier(n_neighbors=7)\n",
